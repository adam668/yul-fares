# Resend: https://resend.com — free tier covers 3,000 emails/month.
# Verify a domain you own (kestrile.com) and send from it; the shared
# onboarding@resend.dev sender only reaches your own signup address.
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=fares@yourdomain.com
MAIL_TO=you@yourdomain.com

ORIGIN=YUL
CURRENCY=CAD

# The bar. 0.40 = 40% below the route's normal price.
DISCOUNT_FLOOR=0.40
MIN_ABS_SAVING=250
MAX_PRICE=1600
MAX_DEEP_DIVES=7

# Send a "nothing today" email instead of staying quiet.
SEND_WHEN_EMPTY=0

DB_PATH=prices.db
